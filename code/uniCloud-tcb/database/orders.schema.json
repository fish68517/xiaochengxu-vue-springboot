{
  "bsonType": "object",
  "required": ["brandId", "orderNo", "productId", "customerId", "amountFen", "status", "commission", "createdAt"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": { "bsonType": "string", "description": "主键（统一 _id 为业务主键）" },
    "orderNo": { "bsonType": "string", "description": "业务单号（唯一，P+yyyyMMdd+8 位序列）" },
    "brandId": { "bsonType": "string", "description": "下单来源品牌（必填）" },
    "productId": { "bsonType": "string" },
    "customerId": { "bsonType": "string" },
    "amountFen": { "bsonType": "int" },
    "status": {
      "bsonType": "string",
      "enum": ["PENDING_PAYMENT", "PENDING_ACCEPT", "PENDING_GRAB", "ASSIGN_PENDING", "IN_SERVICE", "PENDING_CONFIRM", "SETTLED", "DISPUTING", "CANCELLED", "REFUNDING", "REFUNDED", "CLOSED"]
    },
    "productSnapshot": { "bsonType": "object", "description": "商品快照（名称/保底/价格）" },
    "brandSnapshot": { "bsonType": "object", "description": "品牌公开配置版本快照" },
    "commissionRuleSnapshot": { "bsonType": "object", "description": "佣金规则与版本快照" },
    "paymentId": { "bsonType": "string", "description": "当前支付单引用" },
    "idempotencyKey": { "bsonType": "string", "description": "客户端下单幂等键" },
    "idempotencyScope": { "bsonType": "string", "description": "brandId + 买家身份的幂等作用域" },
    "contactWechat": { "bsonType": "string", "description": "下单联系方式-微信号（加密存储）" },
    "contactPhone": { "bsonType": "string", "description": "下单联系方式-手机号（加密存储）" },
    "isVip": { "bsonType": "bool", "description": "支付时按 VIP 名单匹配打标" },
    "game": { "bsonType": "string", "description": "录入-游戏" },
    "region": { "bsonType": "string", "description": "录入-区服" },
    "serviceType": { "bsonType": "string", "description": "录入-服务类型" },
    "customerUid": { "bsonType": "string", "description": "录入-客户游戏 UID" },
    "customerNickname": { "bsonType": "string", "description": "录入-客户游戏昵称" },
    "expectStartAt": { "bsonType": "number", "description": "期望开始时间" },
    "requirementNote": { "bsonType": "string" },
    "sessionNote": { "bsonType": "string" },
    "internalNote": { "bsonType": "string", "description": "内部备注（仅客服/管理员可见）" },
    "guaranteedOutput": { "bsonType": "int", "description": "保底产出量（快照）" },
    "actualOutput": { "bsonType": "number", "description": "实际产出量（完成申请）" },
    "verificationStatus": { "bsonType": "string", "enum": ["PENDING", "VERIFIED", "REJECTED"] },
    "verifiedBy": { "bsonType": "string" },
    "verifiedAt": { "bsonType": "number" },
    "verificationNote": { "bsonType": "string" },
    "verificationRejectReason": { "bsonType": "string" },
    "reworkCount": { "bsonType": "int", "description": "补单次数（服务中子标记）" },
    "formData": { "bsonType": "object" },
    "workerId": { "bsonType": "string" },
    "commission": { "bsonType": "object", "description": "下单时快照的抽成配置（内部卷 commission_rate）" },
    "earningsFen": { "bsonType": "int", "description": "结算佣金金额（分，退款追回全额；内部卷 commission_fen）" },
    "transactionId": { "bsonType": "string", "description": "微信支付流水号（唯一，幂等；内部卷 pay_transaction_id）" },
    "payerOpenid": { "bsonType": "string", "description": "付款人 openid" },
    "refundStatus": {
      "bsonType": "string",
      "enum": ["PENDING_APPROVAL", "PROCESSING", "SUCCESS", "FAILED"],
      "description": "退款子阶段"
    },
    "cancelReason": { "bsonType": "string" },
    "cancellation": { "bsonType": "object" },
    "payDeadline": { "bsonType": "number", "description": "支付截止时间（创建 + 30 分钟）" },
    "paidAt": { "bsonType": "number" },
    "pooledAt": { "bsonType": "number", "description": "入池时间（抢单池超时扫描）" },
    "grabbedAt": { "bsonType": "number" },
    "acceptedAt": { "bsonType": "number" },
    "completedAt": { "bsonType": "number" },
    "closedAt": { "bsonType": "number" },
    "refundedAt": { "bsonType": "number" },
    "disputeDeadline": { "bsonType": "number", "description": "异议截止（结单 + 72h）" },
    "createdAt": { "bsonType": "number" },
    "updatedAt": { "bsonType": "number" }
  }
}
