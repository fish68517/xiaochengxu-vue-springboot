{
  "bsonType": "object",
  "required": ["brandId", "version", "configSnapshot", "status", "createdAt"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "properties": {
    "_id": { "bsonType": "string" },
    "brandId": { "bsonType": "string" },
    "version": { "bsonType": "int", "minimum": 1 },
    "configSnapshot": { "bsonType": "object" },
    "status": { "bsonType": "string", "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"] },
    "createdBy": { "bsonType": "string" },
    "publishedBy": { "bsonType": "string" },
    "createdAt": { "bsonType": "number" },
    "publishedAt": { "bsonType": "number" }
  }
}
