# 运行环境：development / staging / production
APP_ENV=development
API_MODE=local
PAYMENT_MODE=mock
MESSAGE_MODE=mock
BRAND_CODE=demo-a

# 前端公开变量（可以进入构建产物，严禁放密钥）
VITE_API_BASE=http://127.0.0.1:4176
VITE_APP_ENV=development
VITE_API_MODE=local
VITE_BRAND_CODE=demo-a
VITE_BRAND_DISPLAY_NAME=星河服务
VITE_WECHAT_APP_ID=wxdemoa20260001
VITE_PUBLIC_CHANNEL_ID=demo-a-mini-program

# staging/production 服务端变量（此文件仅列键名，实际值进入 Secret 管理）
SESSION_SECRET=replace-in-secret-manager
H5_TOKEN_SECRET=replace-in-secret-manager
H5_TOKEN_TTL_MS=86400000
INTERNAL_SECRET=replace-with-independent-secret-at-least-32-chars
SCHEDULER_SECRET=replace-with-independent-secret-at-least-32-chars
UNICLOUD_PROVIDER=tencent
UNICLOUD_SPACE=replace-with-space-id
HOSTING_CLIENT_SPACE=replace-with-client-space-id
HOSTING_BACKEND_SPACE=replace-with-backend-space-id
HOSTING_CLIENT_URL=https://replace.example.com
HOSTING_BACKEND_URL=https://replace-admin.example.com
H5_ORDER_BASE_URL=https://replace.example.com
WECHAT_PAY_MCHID=replace-in-secret-manager
WECHAT_PAY_SERIAL_NO=replace-in-secret-manager
WECHAT_PAY_PRIVATE_KEY=replace-in-secret-manager
WECHAT_PAY_APIV3_KEY=replace-in-secret-manager
WECHAT_PAY_APPID=replace-with-bound-appid
WECHAT_PAY_NOTIFY_URL=https://replace.example.com/pay-notify
WECHAT_MP_KF_TOKEN=replace-in-secret-manager
WECHAT_MP_APPID=replace-with-certified-appid
WECHAT_MP_SECRET=replace-in-secret-manager

# 账户安全、隐私、支付路由、告警和备份（staging/production 必填）
ACCOUNT_SECURITY_ENFORCE=false
# 联调兼容：true 时管理和客服角色仅使用账号密码，不强制 MFA/二次验证；正式商用建议保持 false。
ADMIN_SIMPLE_LOGIN=false
MFA_ENCRYPTION_KEY=replace-with-base64-32-byte-key
MFA_ENCRYPTION_KEY_VERSION=v1
PII_KEY_VERSION=v1
PII_KEYS_JSON={"v1":"replace-with-base64-32-byte-key"}
PII_BLIND_INDEX_KEY=replace-with-independent-base64-32-byte-key
PRIVACY_LEGAL_DOCUMENTS_JSON=[]
PRIVACY_RETENTION_POLICY_JSON={"approved":false}
ACCOUNT_CLOSURE_COOLING_DAYS=7
WECHAT_PAY_CONFIG_MAP={}
ALERT_WEBHOOK_URL=https://replace.example.com/alert-webhook
BACKUP_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# production 发布门禁
RELEASE_APPROVED=false
COMMERCIAL_DECISIONS_APPROVED=false
BRAND_ENTITY_MODE=single-entity
PRODUCTION_BRAND_CODES=
DEMO_DATA_ENABLED=true
DB_BACKUP_ID=
ROLLBACK_BUNDLE_PATH=
COMMERCIAL_EVIDENCE_MANIFEST=
SECURITY_SCAN_REPORT=
SBOM_PATH=
CAPACITY_REPORT=
