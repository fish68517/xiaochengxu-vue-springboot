<view class="container">
  <view class="header">
    <text class="privacy-text">请完善用户信息，我们会保护用户信息</text>
  </view>

  <view class="avatar-section">
    <image class="avatar" src="{{avatarSrc}}" bindtap="chooseAvatar"></image>
    <view class="edit-icon">
      <image src="/assets/icons/edit.png"></image>
    </view>
  </view>

  <view class="form-section">
    <view class="form-item">
      <text class="label">姓名</text>
      <input class="input" placeholder="请输入姓名" data-field="name" bindinput="onInputChange" />
    </view>
    <view class="form-item">
      <text class="label">出生日期</text>
      <picker class="picker" mode="date" bindchange="onDateChange">
        <view class="picker-content">{{birthDate || '请选择出生日期'}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">家庭住址</text>
      <input class="input" placeholder="请输入您的家庭住址" data-field="address" bindinput="onInputChange" />
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="请输入手机号" data-field="phone" bindinput="onInputChange" />
    </view>

    <view class="form-item">
      <text class="label">密码</text>
      <input class="input" type="password" placeholder="请输入密码" data-field="password" bindinput="onInputChange" />
    </view>

    <view class="form-item">
      <text class="label">确认密码</text>
      <input class="input" type="password" placeholder="请再次输入密码" data-field="confirmPassword" bindinput="onInputChange" />
    </view>
  </view>
  <button class="next-button {{isFormComplete ? 'active' : ''}}" bindtap="onNextStep">下一步</button>
</view> 