/* pages/userInfo/userInfo.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background-color: #FFFFFF;
  height: 1500rpx;
}

.header {
    margin-top: 150rpx;
  margin-bottom: 20rpx;
}

.privacy-text {
  font-size: 30rpx;
  color: #888;
}

.avatar-section {
  position: relative;
  margin-bottom: 40rpx;
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 75rpx;
  background-color: #E0E0E0;
}

.edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: #00C853;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-section {
  width: 100%;
  max-width: 600rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  border: none;
  border-bottom: 1px solid #00C853;
  font-size: 28rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.picker {
  width: 100%;
  height: 80rpx;
  border-bottom: 1px solid #00C853;
  display: flex;
  align-items: center;
}

.picker-content {
  font-size: 28rpx;
  color: #888;
}

.next-button {
  width: 100%;
  max-width: 600rpx;
  height: 80rpx;
  background-color: #E0E0E0;
  color: #FFFFFF;
  font-size: 32rpx;
  border-radius: 40rpx;
  text-align: center;
  line-height: 80rpx;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.next-button.active {
  background-color: #00C853; /* Green background */
} 
wx-image {
    display: inline-block;
    height: 10px;
    overflow: hidden;
    width: 10px;
}