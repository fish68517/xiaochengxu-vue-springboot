.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background-color: #f8f8f8;
}

.search-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-input-container {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #333;
}

.filter-button {
  width: 72rpx;
  height: 72rpx;
  background-color: #ffffff;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.filter-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
}

.favorite-list-container {
  flex: 1;
  overflow: hidden;
  padding: 20rpx 0;
}

.favorite-scroll-view {
  height: 100%;
}

.favorite-item {
  background-color: #ffffff;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 30rpx;
  margin: 0 20rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.station-icon-container {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.available-bg {
  background-color: #4CAF50;
}

.busy-bg {
  background-color: #FF5252;
}

.station-icon {
  width: 48rpx;
  height: 48rpx;
}

.station-info {
  flex: 1;
}

.station-name {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  color: #333;
}

.station-address {
  font-size: 24rpx;
  color: #999;
}

.station-arrow {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.4;
} 