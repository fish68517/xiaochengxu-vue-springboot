/* pages/carDetails/carDetails.wxss */
.detail-item {
    margin: 2px 0;
    padding: 8px;
    border-radius: 8px;
    border: 1px solid #ddd;
    text-align: center;
    font-size: 16px;
    width: 600rpx;
  }
  .confirm-button{
      color: #fff;
      margin-top: 40rpx;
      background-color: #01b763;
  }
  button:not([size=mini]) {
      margin-left: auto;
      margin-right: auto;
      width: 320px;
      border-radius: 50rpx;
  }
  .image-container{
      margin-top: -40rpx;
  }
  button:not([size=mini]) {
      margin-left: auto;
      margin-right: auto;
      width: 200px;
      border-radius: 50rpx;
  }