}

.comment-container {
  padding: 20rpx;
  background-color: #fff;
  display: flex;
  flex-direction: column;
}

/* 输入区域 */
.input-area {
  position: relative;
  margin-bottom: 20rpx;
}

/* 输入框样式 */
.comment-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 占位符样式 */
.placeholder-style {
  color: #999;
}

/* 字数统计 */
.word-count {
  position: absolute;
  right: 20rpx;
  bottom: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 按钮区域 */
.btn-area {
  display: flex;
  justify-content: flex-end;
}

/* 提交按钮 */
.submit-btn {
  width: 80%;
  height: 76rpx;
  padding-top:10rpx ;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  background-color: #07C160;
}

/* 禁用状态按钮 */
.submit-btn[disabled] {
  background-color: #ccc !important;
  color: #fff;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 20rpx 0;
}