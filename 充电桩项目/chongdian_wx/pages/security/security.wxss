.container {
    padding: 0;
  }
  
  .setting-item {
    width: 80%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background-color: #ffffff;
  }
  
  .setting-item text {
    font-size: 16px;
    color: #333;
    text-align: left;
    flex: 1;
  }
  
  .setting-item switch {
    flex: none;
  }
  
  .arrow {
    position: relative;
  }
  
  .arrow-icon {
    width: 16px;
    height: 16px;
  }
  
  .button-container {
    padding: 20px;
    margin-top: 20px;
    text-align: right;
  }
  
  .update-password {
    width: 100%;
    height: 44px;
    line-height: 44px;
    background-color: #f0f9f0;
    color: #07c160;
    border: none;
    border-radius: 8px;
    font-size: 16px;
  }