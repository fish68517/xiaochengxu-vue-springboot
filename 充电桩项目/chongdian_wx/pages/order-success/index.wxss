.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: #fff;
  padding: 40rpx;
}

.success-icon {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.circle {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  background: #00C853;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check {
  width: 80rpx;
  height: 40rpx;
  border-left: 8rpx solid white;
  border-bottom: 8rpx solid white;
  transform: rotate(-45deg) translate(10rpx, -10rpx);
}

.dots {
  position: absolute;
  width: 100%;
  height: 100%;
}

.dot {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  background: #7CEB9D;
  border-radius: 50%;
}

.dot1 {
  top: -10rpx;
  left: 90rpx;
}

.dot2 {
  top: 90rpx;
  right: -10rpx;
}

.dot3 {
  bottom: -10rpx;
  left: 90rpx;
}

.dot4 {
  top: 90rpx;
  left: -10rpx;
}

.success-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.sub-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.confirm-button {
  width: 90%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #00C853;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
} 