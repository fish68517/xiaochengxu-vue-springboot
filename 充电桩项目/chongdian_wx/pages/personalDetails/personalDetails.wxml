<!--pages/personalDetails/personalDetails.wxml-->
<!-- <van-nav-bar title="个人信息详情" left-text="我的" right-text="" left-arrow bind:click-left="onClickLeft" bind:click-right="onClickRight" class="van-nav-bar" /> -->
<view class="container">
  <view class="avatar-section">
    <view class="avatar-wrapper">
      <image class="avatar" src="/assets/images/avatar-placeholder.jpg" mode="aspectFill"/>
      <view class="edit-badge">
        <image class="edit-icon-small" src="/assets/icons/edit.png"/>
      </view>
    </view>
  </view>
  <!-- 信息展示列表 -->
  <view class="form-section">
    <view class="form-item">
      <text class="label">姓名</text>
      <input class="input" value="{{userInfo.name}}" placeholder="请输入姓名"/>
    </view>
    <view class="divider"></view>

    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" value="{{userInfo.phoneNum}}" type="number" placeholder="请输入手机号"/>
    </view>
    <view class="divider"></view>

    <view class="form-item">
      <text class="label">Email</text>
      <input class="input" value="{{userInfo.email}}" type="email" placeholder="请输入邮箱"/>
    </view>
    <view class="divider"></view>

    <view class="form-item">
      <text class="label">出生日期</text>
      <view class="picker-wrapper">
        <text class="picker-text">{{userInfo.birthday}}</text>
        <image class="calendar-icon" src="/assets/icons/calendar.png"/>
      </view>
    </view>
    <view class="divider"></view>

    <view class="form-item">
      <text class="label">联系地址</text>
      <view class="picker-wrapper">
        <text class="picker-text">{{userInfo.address}}</text>
        <image class="arrow-icon" src="/assets/icons/arrow-right.png"/>
      </view>
    </view>
    <view class="divider"></view>
    <view class="form-item">
      <text class="label">国家</text>
      <view class="picker-wrapper">
        <text class="picker-text">中国</text>
        <image class="arrow-icon" src="/assets/icons/arrow-right.png"/>
      </view>
    </view>
    <view class="divider"></view>
  </view>
<!-- 
  <button class="save-btn" bind:tap="saveInfo">保存</button> -->
</view>