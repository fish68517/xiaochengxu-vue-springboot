.container {
  /* min-height: 100vh; */
  background: #F8F8F8;
}

/* 标签页样式 */
.tabs {
  width: 376px;
  display: flex;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab-item text {
  font-size: 32rpx;
  color: #666666;
}

.tab-item.active text {
  color: #00C853;
  font-weight: 500;
}
.divider-vertical {
  width: 1rpx;
  height: 88rpx;
  background-color: #ebebeb;
  margin: 0 30rpx;
  align-self: center;
}
.tab-line {
  position: absolute;
  bottom: 0;
  width: 355rpx;
  height: 1rpx;
  background: #00C853;
  border-radius: 2rpx;
}

/* 搜索框样式 */
.search-box {
  width: 332px;
  margin: 41rpx 60rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 二级标签页样式 */
.sub-tabs {
  white-space: nowrap;
  padding: 0 32rpx;
  background: #FFFFFF;
  margin-bottom: 20rpx;
  margin-top: 10px;
}

.sub-tab {
  display: inline-block;
  padding: 24rpx 49rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.sub-tab.active {
  background-color:#00c853;
  border-radius: 23px;
  color:white;
  font-weight: 500;
}

.sub-tab-line {
  position: absolute;
  bottom: 0;
  left: 32rpx;
  right: 32rpx;
  height: 4rpx;
  background: #00C853;
  transition: all 0.3s;
}

/* 内容区域样式 */
/* .content {
