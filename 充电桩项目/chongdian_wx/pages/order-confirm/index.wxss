.container {
  padding: 20rpx;
  background-color: #ffffff;
  margin-top: 50rpx;
}

.header {
  padding: 20rpx 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.section {
  background-color: #fafafa;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  width: 85%;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 车辆信息样式 */
.car-info, .station-info {
  display: flex;
  align-items: center;
}

.car-icon, .station-icon {
  width: 240rpx;
  height: 240rpx;
  margin-right: 20rpx;
}

.car-details, .station-details {
  flex: 1;
  margin-left: 50rpx;
}

.car-name, .station-name {
  font-size: 43rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.car-model, .station-address {
  font-size: 38rpx;
  color: #666;
}

/* Charger信息样式 */
.charger-info {
  padding: 10rpx 0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
}

.charger-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.power-value {
  font-weight: bold;
}

/* 时间和费用信息样式 */
.info-label {
  font-size: 30rpx;
  color: #666;
}

.info-value {
  font-size: 30rpx;
  color: #333;
}

.total {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.highlight {
  color: #00C853;
  font-weight: bold;
  font-size: 36rpx;
}

/* 支付方式样式 */
.payment-info {
  display: flex;
  align-items: center;
  padding-left: 130rpx;
}
.payment-info text{
  font-size: 45rpx;
}

.payment-icon {
  width: 98rpx;
  height: 98rpx;
  margin-right: 20rpx;
}

/* 提示信息样式 */
.notice {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 30rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  margin: 20rpx 0;
}

.notice-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background-color: #00C853;
  color: #fff;
  border-radius: 50%;
  margin-right: 20rpx;
  font-size: 24rpx;
}

.notice-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 提交按钮样式 */
.submit-button {
  width: 90%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #00C853;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
} 