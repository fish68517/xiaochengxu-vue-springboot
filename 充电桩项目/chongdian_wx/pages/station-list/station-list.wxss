.container {
  background: #ffffff;
}

.search-header {
  margin-top: 50rpx;
  width: 85%;
  padding: 10px 15px;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 10px;
}

.search-box {
  flex: 1;
  height: 50px;
  background: #f5f5f5;
  border-radius: 18px;
  display: flex;
  align-items: center;
  padding: 0 15px;
}

.search-box icon {
  margin-right: 6px;
}

.search-box input {
  flex: 1;
  font-size: 14px;
}

.filter-btn {
  width: 24px;
  height: 24px;
}
.filter-button {
  width: 80rpx;
  height: 80rpx;
  background-color:white;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.filter-icon {
  width: 40rpx;
  height: 40rpx;
}

.station-item {
  background: #fff;
  padding: 15px;
  display: flex;
  align-items: center;
  border-bottom: 1px solid #eee;
}

.station-icon {
  width: 100px;
  height: 100px;
  margin-right: 12px;
}

.station-icon image {
  width: 100%;
  height: 100%;
}

.station-info {
  flex: 1;
  margin-right: 90px;
  margin-left: 25rpx;
}

.station-name {
  font-size: 24px;
  color: #333;
  margin-bottom: 4px;
}

.station-address {
  font-size: 12px;
  color: #999;
}

.station-arrow {
  width: 25px;
  height: 25px;
}

.station-arrow image {
  width: 100%;
  height: 100%;
}

.home-button {
  position: fixed;
  right: 30rpx;
  bottom: 220rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.home-button image {
  width: 60rpx;
  height: 60rpx;
}