.container {
  margin-top: 60rpx;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.header {
  display: flex;
  width: 90%;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  position: relative;
  margin: 0 auto;
}

.back-icon, .add-icon {
  width: 45rpx;
  height: 45rpx;
}

.back-icon image, .add-icon image {
  width: 100%;
  height: 100%;
}

.title {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
}

.car-list {
  padding: 0 20rpx;
  width: 85%;

}

.car-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
  background: #fafafa;
  border-radius: 38rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.car-info {
  display: flex;
  align-items: center;
}

.car-icon {
  width: 180rpx;
  height: 130rpx;
  margin-right: 20rpx;
}

.car-details {
  display: flex;
  flex-direction: column;
}

.brand {
  font-size: 46rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.model {
  font-size: 36rpx;
  color: #666;
}

.select-indicator {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
}

.select-indicator.selected {
  background: #00C853;
  border-color: #00C853;
}

.next-step {
  width: 70%;
  margin-top: -50rpx;
}

.next-button {
  background: #00C853;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
 
}
