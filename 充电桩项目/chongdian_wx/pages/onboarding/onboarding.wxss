.swiper {
  width: 100%;
  height: 100vh;
}

.onboarding-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 40rpx;
  box-sizing: border-box;
  position: relative;
}

.bubbles {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.main-circle {
  width: 400rpx;
  height: 400rpx;
  margin-bottom: 60rpx;
  position: relative;
  z-index: 2;
}

.icon {
  width: 160rpx;
  height: 160rpx;
}

.content {
  text-align: center;
  margin-bottom: 100rpx;
  z-index: 2;
}

.title {
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  line-height: 1.3;
}

.desc {
  font-size: 28rpx;
  color: var(--light-text);
  line-height: 1.6;
  max-width: 600rpx;
}

.dots {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-bottom: 60rpx;
  z-index: 2;
}

.dot {
  width: 20rpx;
  height: 8rpx;
  background-color: #CCCCCC;
  border-radius: 4rpx;
  margin: 0 8rpx;
  transition: all 0.3s;
}

.dot.active {
  width: 40rpx;
  background-color: var(--primary-color);
}

.buttons {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  width: 100%;
  z-index: 2;
}

.btn-skip {
  background-color: transparent;
  color: var(--light-text);
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  border-radius: 40rpx;
}

.btn-primary {
  width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
}

.icon-text {
  font-size: 80rpx;
  color: #fff;
} 