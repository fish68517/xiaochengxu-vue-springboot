.container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-modal {
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.success-icon {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 40rpx;
}

.circle-bg {
  width: 120rpx;
  height: 120rpx;
  background: #00C853;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  width: 40rpx;
  height: 24rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg) translate(4rpx, -4rpx);
}

.dots {
  position: absolute;
  width: 100%;
  height: 100%;
}

.dot {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: #00C853;
  border-radius: 50%;
}

.dot1 { top: 0; left: 50%; transform: translateX(-50%); }
.dot2 { top: 15%; right: 15%; }
.dot3 { right: 0; top: 50%; transform: translateY(-50%); }
.dot4 { bottom: 15%; right: 15%; }
.dot5 { bottom: 15%; left: 15%; }
.dot6 { left: 0; top: 50%; transform: translateY(-50%); }

.success-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #00C853;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 48rpx;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #00C853;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.confirm-btn::after {
  border: none;
}