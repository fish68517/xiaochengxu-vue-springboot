.container {
  padding: 20rpx;
  background-color: #ffffff;
  margin-top: 60rpx;
}

.section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  width: 85%;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.select-wrapper {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
}

.picker {
  width: 100%;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
  color: #333;
}

.time-input {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
}

.time-input input {
  width: 100%;
  height: 60rpx;
  font-size: 28rpx;
}

.price-display {
  display: flex;
  align-items: center;
  font-size: 38rpx;
}

.price {
  color: #00C853;
  font-weight: bold;
  margin-left: 20rpx;
}

.payment-list {
  background-color: #fff;
}

.payment-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  height: 50rpx;
}

.payment-item:last-child {
  border-bottom: none;
}

.payment-left {
  display: flex;
  align-items: center;
}

.payment-right {
  display: flex;
  align-items: center;
}

.payment-icon {
  width: 68rpx;
  height: 68rpx;
  margin-right: 20rpx;
}

.payment-left text {
  font-size: 38rpx;
  color: #333;
}

.wallet-balance {
  font-size: 32rpx;
  color: #00C853;
  margin-right: 20rpx;
}

.next-button {
  position: fixed;
  bottom: 80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #00C853;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
} 