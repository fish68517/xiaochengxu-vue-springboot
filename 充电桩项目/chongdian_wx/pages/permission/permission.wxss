.container {
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.permission-card {
  width: 100%;
  background-color: var(--white);
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.green-circle {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

.icon {
  width: 80rpx;
  height: 80rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-align: center;
}

.desc {
  font-size: 28rpx;
  color: var(--light-text);
  text-align: center;
  margin-bottom: 60rpx;
  line-height: 1.5;
}

.authorize-btn {
  width: 100%;
  margin-bottom: 20rpx;
}

.cancel-btn {
  width: 100%;
}

.icon-text {
  font-size: 80rpx;
  color: var(--white);
} 