<view class="page data-v-2c5296db"><view class="top-bar data-v-2c5296db"><input class="search-input data-v-2c5296db" placeholder="搜索充电站名称" bindinput="{{a}}" value="{{b}}"/><button class="small-btn data-v-2c5296db" bindtap="{{c}}">刷新</button><button class="small-btn data-v-2c5296db" bindtap="{{d}}">退出</button></view><map id="mainMap" class="map data-v-2c5296db" longitude="{{e}}" latitude="{{f}}" scale="{{g}}" markers="{{h}}" show-location="{{true}}" bindmarkertap="{{i}}"/><view class="ops data-v-2c5296db"><button class="op-btn data-v-2c5296db" bindtap="{{j}}">定位</button><button class="op-btn recommend data-v-2c5296db" bindtap="{{k}}">一键推荐预约</button></view><view wx:if="{{l}}" class="station-card data-v-2c5296db"><view class="name data-v-2c5296db">{{m}}</view><view class="line data-v-2c5296db">地址：{{n}}</view><view class="line data-v-2c5296db"> 评分：{{o}} <text class="split data-v-2c5296db">|</text> 桩数：{{p}}</view><view class="line data-v-2c5296db">简化预约策略：优先近距离 + 高评分站点</view></view><scroll-view class="list data-v-2c5296db" scroll-y><view wx:for="{{q}}" wx:for-item="item" wx:key="c" class="item data-v-2c5296db" bindtap="{{item.d}}"><view class="item-title data-v-2c5296db">{{item.a}}</view><view class="item-sub data-v-2c5296db">{{item.b}}</view></view><view wx:if="{{r}}" class="empty data-v-2c5296db">暂无匹配站点</view></scroll-view></view>